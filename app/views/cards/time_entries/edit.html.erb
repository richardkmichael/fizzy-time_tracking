<%= turbo_frame_tag @time_entry, :container do %>
  <div id="<%= dom_id(@time_entry) %>" class="time-entry flex align-start full-width">
    <figure class="time-entry__avatar flex-item-no-shrink" aria-hidden="true">
      <%= avatar_tag @time_entry.creator, hidden_for_screen_reader: true %>
    </figure>

    <div class="time-entry__content flex flex-column flex-item-grow full-width">
      <%= form_with model: [ @card, @time_entry ], class: "flex flex-column gap full-width",
            data: { controller: "form", action: "keydown.ctrl+enter->form#submit:prevent keydown.meta+enter->form#submit:prevent keydown.esc->form#cancel:stop" } do |form| %>
        <div class="flex align-center gap full-width">
          <%= form.number_field :hours, value: @time_entry.hours_value, min: 0, step: 1, placeholder: "Hours", class: "input input--small time-entry__form-input" %>
          <%= form.number_field :minutes, value: @time_entry.minutes_value, min: 0, max: 59, step: 1, placeholder: "Minutes", class: "input input--small time-entry__form-input" %>
          <%= form.date_field :date, required: true, class: "input input--small time-entry__form-input" %>
          <%= form.text_field :description, placeholder: "Description (optional)", class: "input input--small flex-item-grow time-entry__form-input" %>
        </div>
        <div class="flex gap-half justify-start align-center">
          <%= form.button class: "btn btn--reversed", type: :submit, title: "Save changes (#{ hotkey_label(["ctrl", "enter"]) })" do %>
            <span>Save</span>
          <% end %>
          <%= link_to card_time_entry_path(@card, @time_entry), class: "btn", data: { form_target: "cancel" }, title: "Cancel (#{ hotkey_label(["esc"]) })" do %>
            <span>Cancel</span>
          <% end %>

          <%= tag.button type: :submit, class: "btn btn--negative flex-item-justify-end", form: dom_id(@time_entry, :delete_form),
                data: { turbo_confirm: "Are you sure you want to delete this time entry?" } do %>
            <%= icon_tag "trash" %>
            <span class="for-screen-reader">Delete</span>
          <% end %>
        </div>
      <% end %>

      <%= form_with url: card_time_entry_path(@card, @time_entry), method: :delete, id: dom_id(@time_entry, :delete_form), data: { turbo_frame: "_top" } %>
    </div>
  </div>
<% end %>
